{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "title": "CiteShift AIO Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "url": {
      "title": "Business Website URL",
      "type": "string",
      "description": "Canonical business website URL from the upstream profile creator output.",
      "editor": "textfield",
      "prefill": "https://www.apify.com/",
      "default": "https://www.apify.com/"
    },
    "business_profile": {
      "title": "Business Profile",
      "type": "object",
      "description": "Structured profile generated by the upstream citeshift-profile-creator actor.",
      "editor": "json",
      "properties": {
        "business_name": {
          "type": "string"
        },
        "business_type": {
          "type": "string",
          "enum": [
            "hotel",
            "restaurant",
            "museum",
            "local_experience",
            "mixed_hospitality",
            "unknown"
          ]
        },
        "city": {
          "type": ["string", "null"]
        },
        "country": {
          "type": ["string", "null"]
        },
        "traveler_personas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signature_offers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["business_name", "business_type"]
    },
    "search_queries": {
      "title": "Traveler Prompts",
      "type": "array",
      "description": "Traveler-style prompts generated by the upstream citeshift-profile-creator actor.",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "query_source": {
      "title": "Query Source",
      "type": "string",
      "description": "Optional provenance tag from upstream actor.",
      "default": "generated"
    },
    "discovery_source": {
      "title": "Discovery Source",
      "type": "string",
      "description": "Optional discovery context source from upstream actor."
    }
  },
  "required": ["url", "business_profile", "search_queries"]
}
