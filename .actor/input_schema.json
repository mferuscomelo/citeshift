{
  "$schema": "https://apify.com/schemas/v1/input.ide.json",
  "title": "Scrape data from a web page",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "url": {
      "title": "URL of the brand website",
      "type": "string",
      "description": "The URL of website",
      "editor": "textfield",
      "prefill": "https://www.apify.com/"
    },
    "search_query": {
      "title": "Search Queries",
      "type": "array",
      "description": "The search queries to use when looking up citations",
      "editor": "stringList",
      "prefill": [
        "best lead scraping tools"
      ],
      "default": [
        "best lead scraping tools"
      ],
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": ["url", "search_query"]
}
